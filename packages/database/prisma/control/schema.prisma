// Control database: identities, organizations, memberships, and the tenant -> shard directory.
// One physical database (postgres-control). Business records live in the tenant shards.

generator client {
  provider            = "prisma-client"
  output              = "../../src/generated/control"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum MembershipRole {
  ADMIN
  MANAGER
  EMPLOYEE

  @@map("membership_role")
}

/// Configured shard keys. Server configuration maps each key to a connection URL;
/// the database never stores URLs, and callers can never choose a key.
enum ShardKey {
  SHARD_A @map("shard-a")
  SHARD_B @map("shard-b")

  @@map("shard_key")
}

/// The user pool: who can sign in. Organization permissions live in Membership.
model User {
  id                 String      @id @default(uuid(7)) @db.Uuid
  /// Trimmed + lowercased email; globally unique across all organizations.
  normalizedEmail    String      @unique @map("normalized_email") @db.VarChar(254)
  displayName        String      @map("display_name") @db.VarChar(120)
  /// Argon2id encoded hash. Never returned by the API or logged.
  passwordHash       String      @map("password_hash")
  isActive           Boolean     @default(true) @map("is_active")
  mustChangePassword Boolean     @default(false) @map("must_change_password")
  /// Incremented on password change; sessions created before it are rejected (M3).
  sessionVersion     Int         @default(0) @map("session_version")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  membership         Membership?

  @@map("users")
}

model Organization {
  id          String              @id @default(uuid(7)) @db.Uuid
  slug        String              @unique @db.VarChar(40)
  name        String              @db.VarChar(120)
  isActive    Boolean             @default(true) @map("is_active")
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships Membership[]
  directory   TenantDirectory?
  auditEvents ControlAuditEvent[]

  @@map("organizations")
}

/// A user's role inside one organization. MVP: at most one membership per user (userId unique).
model Membership {
  id             String         @id @default(uuid(7)) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  role           MembershipRole
  isActive       Boolean        @default(true) @map("is_active")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("memberships")
}

/// Directory-based sharding: which tenant shard holds this organization's business records.
model TenantDirectory {
  organizationId String       @id @map("organization_id") @db.Uuid
  shardKey       ShardKey     @map("shard_key")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@map("tenant_directory")
}

/// Account/membership administration events. Append-only for the runtime role.
model ControlAuditEvent {
  id             String        @id @default(uuid(7)) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(64)
  targetId       String?       @map("target_id") @db.Uuid
  /// Allowlisted, non-secret details only.
  metadata       Json          @default("{}")
  occurredAt     DateTime      @default(now()) @map("occurred_at") @db.Timestamptz(3)
  requestId      String?       @map("request_id") @db.VarChar(64)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, occurredAt(sort: Desc), id(sort: Desc)])
  @@map("control_audit_events")
}
