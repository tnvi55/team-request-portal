# Template for the Git-ignored .env file. Do not edit secrets here; run `pnpm local:setup`.
# It copies this file to .env, replaces __GENERATE__ with random secrets, fills ${NAME}
# references from other values, and never overwrites values that already exist in .env.

# Postgres containers. The superuser is only used by the containers' first-time init.
POSTGRES_ADMIN_PASSWORD=__GENERATE__
PG_MIGRATOR_PASSWORD=__GENERATE__
PG_RUNTIME_PASSWORD=__GENERATE__

# Redis
REDIS_PASSWORD=__GENERATE__

# API running on the host in development (the replica demo builds its own container URLs).
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
APP_ORIGIN=http://localhost:8080
INSTANCE_ID=local
CONTROL_DATABASE_URL=postgres://trp_runtime:${PG_RUNTIME_PASSWORD}@127.0.0.1:5433/trp_control
SHARD_A_DATABASE_URL=postgres://trp_runtime:${PG_RUNTIME_PASSWORD}@127.0.0.1:5434/trp_shard_a
SHARD_B_DATABASE_URL=postgres://trp_runtime:${PG_RUNTIME_PASSWORD}@127.0.0.1:5435/trp_shard_b
REDIS_URL=redis://default:${REDIS_PASSWORD}@127.0.0.1:6380
SESSION_SECRET=__GENERATE__
CURSOR_SECRET=__GENERATE__
